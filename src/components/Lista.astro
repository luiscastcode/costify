---
import { IoCheckmarkCircle } from "react-icons/io5";

interface Props {
  titulolista: string;
  listadescrip: string;
}

const { titulolista, listadescrip } = Astro.props;
---

<div class="flex gap-x-4 sm:gap-x-6 group">
  <!-- Icono con círculo de fondo -->
  <div class="shrink-0 mt-1">
    <div class="flex items-center justify-center w-9 h-9 rounded-full bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 transition-colors duration-200 group-hover:bg-blue-200 dark:group-hover:bg-blue-800/40">
      <IoCheckmarkCircle className="w-5 h-5" />
    </div>
  </div>
  
  <!-- Contenido -->
  <div class="grow">
    <h3 class="text-base sm:text-lg font-semibold text-gray-800 dark:text-neutral-200">
      {titulolista}
    </h3>
    <p class="mt-1 text-sm sm:text-base text-gray-600 dark:text-neutral-400 leading-relaxed">
      {listadescrip}
    </p>
  </div>
</div>