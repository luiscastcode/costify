---
interface Props {
  text: string;
  href: string;
}

const { text, href } = Astro.props;
---

<li class="text-center inline-flex items-center">
  <a
    href={href}
    class="link block py-2 text-gray-900 hover:font-bold  md:hover:text-blue-700 md:px-4"
    data-navlink
  >
     {text} 
  </a>
</li>