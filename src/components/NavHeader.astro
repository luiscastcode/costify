---
import NavLinks from "./NavLinks.astro";
import NavMovil from "./NavMovil";
import DropdownServicios from "./DropdownServicios.astro";
import DropdownTramites from "./DropdownTramites.astro";
import DropdownMetodosPagos from "./DropdownMetodosPagos.astro"; 
---

<nav class="p-2">
  <div
    class="max-w-screen-xl flex flex-row items-center justify-center mx-auto"
  >
    <a href="/" class="flex items-center mr-auto">
      <img
        src="../../img/logo.png"
        class="rounded-md"
        width="250"
        alt="Mi Logo"
      />
    </a>

    <div class="hidden w-full md:flex md:w-auto">
      <ul
        class="flex flex-col font-medium p-4 md:p-2 mt-4 border border-gray-100 rounded-lg bg-gray-50 md:space-x-8 rtl:space-x-reverse md:flex-row md:mt-0 md:border-0"
      >
        <li>
          <DropdownServicios />
        </li>
        <li>
          <DropdownTramites />
        </li>
        <li>
          <DropdownMetodosPagos />
        </li>
        <NavLinks text="Noticias" href="/noticias/"/>
      </ul>
    </div>
    <NavMovil client:load />
  </div>
</nav>
<script>
  import "../assets/navlink.js";
</script>
