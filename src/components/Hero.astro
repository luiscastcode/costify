---
import BotonPrincipal from "./BotonPrincipal.astro";
import CalculadoraPrecio from "./dolar/CalculadoraPrecio";
 

const { tituloencabezado, nombtn, urlbtn, targetbtn, descriphero, img } =
  Astro.props;
---

<section class="px-1 md:px-4 w-full md:w-full">
  <div
    class="bg-gradient-to-r from-cyan-700 to-blue-300 md:max-h-screen rounded-md grid grid-cols-1 md:grid-cols-2 justify-center items-center"
  >
    <div class="py-8 px-4 md:px-12 flex flex-col">
      <h1 class="mb-4 tracking-tight text-slate-100">
        {tituloencabezado}
      </h1>
      <p class="mb-10 text-slate-200">{descriphero}</p>
      <BotonPrincipal nombtn={nombtn} urlbtn={urlbtn} targetbtn={targetbtn} />
    </div>

    <CalculadoraPrecio client:visible />
  </div>
</section>
