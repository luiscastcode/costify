---
import Hero from "../components/Hero.astro";
import Inicio from "../components/Inicio.astro";

import Layout from "../layouts/Layout.astro";
const {structuredData} = Astro.props
// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<Layout
  metatitle="Calculadora de precios para bodegas"
  metadescrip="Simulador de precios para bodegas: ingresa el costo en USD y tu margen de ganancia y obtienes tu precio en bolívares y el precio en USD a tasa BCV."
  slug=""
  structuredData={structuredData}
>
  <Hero
    tituloencabezado="Simulador de precios en bolívares con margen de ganancia"
    descriphero="Más fácil que una calculadora mágica. Sólo ingresa el costo en dólares, elige tu % de ganancia y a tendrás tu precio en bolívares con margen de ganancia incluido."
    nombtn="Saber Más"
    urlbtn="/#saber-mas"
    img=" "
    
  />
  <Inicio />
</Layout>
