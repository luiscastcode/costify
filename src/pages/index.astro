---
import Hero from "../components/Hero.astro";
import Inicio from "../components/Inicio.astro";

import Layout from "../layouts/Layout.astro";
const {structuredData} = Astro.props
// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<Layout
  metatitle="Calculadora de precios para bodegas + guías PUB Saren"
  metadescrip="Simulador de precios para bodegas: ingresa el costo en USD y te da % ganancia + precio en bolívares a tasa BCV. ."
  slug=""
  structuredData={structuredData}
>
  <Hero
    tituloencabezado="Calculadora para bodegas: precios en bolívares con margen de ganancia y tasa BCV"
    descriphero="Fija tu precio final en segundos. Ingresa el valor en dólares, elige tu % de ganancia y a tasa BCV de hoy. También encontrás guías para trámites como la planilla PUB Saren."
    nombtn="Saber Más Sobre Costify"
    urlbtn="/#saber-mas"
    img=" "
    
  />
  <Inicio />
</Layout>
