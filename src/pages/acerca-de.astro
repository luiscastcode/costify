---
import Layout from "../layouts/Layout.astro";
import Section from "../components/Section.astro";

import Cta from "../components/Cta.astro";
import EncabezadoInterno from "../components/EncabezadoInterno.astro";
import Lista from "../components/Lista.astro";
---

<Layout
  metatitle="Nosotros Podemos Ayudarte | Tu Bodega Al Día"
  metadescrip="Te ayudamos a pagar la factura CANTV en linea o cualquier trámite desde tu computadora o teléfono, sin colas ni gestores, fácil y rapido."
  slug="acerca-de/"
  structuredData={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://costifyprecios.vercel.app/acerca-de",
    "url": "https://costifyprecios.vercel.app/acerca-de",
    "name": "Tu Aliado en Gestión Financiera Digital | Tu Bodega Al Día",
    "description":
      "Te ayudamos a pagar la factura CANTV en linea o cualquier trámite desde tu computadora o teléfono, sin colas ni gestores, fácil y rapido.",
    "isPartOf": {
      "@type": "WebSite",
      "url": "https://costifyprecios.vercel.app/",
      "name": "Tu Bodega Al Día",
      "description":
        "Te ayudamos a pagar la factura CANTV en linea o cualquier trámite desde tu computadora o teléfono",
    },
    "inLanguage": "es_ES"
  }}
>
  <EncabezadoInterno
    tituloencabezado="Somos Tu Socio Digital en Pagos y Trámites en Línea"
    descriphero="En Tu Bodega Al Día, nacemos con la misión de transformar la manera en que las personas y empresas interactúan con los servicios financieros y administrativos en el mundo digital. Somos un equipo multidisciplinario de emprendedores y expertos en finanzas, tecnología y derecho, comprometidos con brindar soluciones innovadoras que eliminen las barreras de la burocracia y la complejidad en los procesos en línea."
    img="tc.png"
  />
  <Section>
    <section
      class="my-10 grid grid-cols-1 md:grid-cols-2 justify-center items-center mx-auto"
    >
      <div class="flex justify-center items-center">
        <img
          class="rounded-md my-3"
          src="/img/man-credit-card.jpg"
          alt="credit card"
        />
      </div>
      <div class="py-8 px-4 md:px-12 flex flex-col justify-between">
        <h2 class="text-center">
          Soluciones Integrales para Tus Necesidades Digitales
        </h2>
        <p class="mb-6">
          No somos solo una plataforma: somos un equipo que entiende tus
          frustraciones con los trámites tradicionales. Por eso, combinamos
          inteligencia artificial para agilizar procesos con atención humana
          personalizada en cada paso.
        </p>
        <Lista
          titulolista="Ahorrar hasta 15 horas en trámites burocráticos"
          listadescrip="Evita colas y atrasos."
        />
        <Lista
          titulolista="Reducir costos operativos en un 30%."
          listadescrip="Una mala gestión te puede costar el doble del pago del trámite."
        />
        <Lista
          titulolista="Guias y Tutoriales."
          listadescrip="Aprende a usar PagoMóvil, Zelle, y billeteras digitales disponibles en Venezuela."
        />
      </div>
    </section>
    <section><!-- Testimonials -->
      <div class="max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14 mx-auto">
        <!-- Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          <!-- Card -->
          <div class="flex flex-col bg-white border border-gray-200 shadow-2xs rounded-xl dark:bg-neutral-900 dark:border-neutral-700">
            <div class="flex-auto p-4 md:p-6">
          
      
              <p class="mt-3 sm:mt-6 text-base text-gray-800 md:text-xl dark:text-white"><em>
                "Gracias a su asesoría legal, mi emprendimiento está formalizado y listo para crecer."
              </em></p>
            </div>
      
            <div class="p-4 rounded-b-xl md:px-6">
              <h3 class="text-sm font-semibold text-gray-800 sm:text-base dark:text-neutral-200">
                William R.
              </h3>
              <p class="text-sm text-gray-500 dark:text-neutral-500">
                Bodega en Ricardo Urriera | Valencia
              </p>
            </div>
          </div>
          <!-- End Card -->
      
          <!-- Card -->
          <div class="flex flex-col bg-white border border-gray-200 shadow-2xs rounded-xl dark:bg-neutral-900 dark:border-neutral-700">
            <div class="flex-auto p-4 md:p-6">
              
              <p class="mt-3 sm:mt-6 text-base text-gray-800 md:text-xl dark:text-white"><em>
                "Pude declarar el ISRL por mi mismo siguiendo la guía, siempre pense que era dificil. "
              </em></p>
            </div>
      
            <div class="p-4 rounded-b-xl md:px-6">
              <h3 class="text-sm font-semibold text-gray-800 sm:text-base dark:text-neutral-200">
                Luis Castillo
              </h3>
              <p class="text-sm text-gray-500 dark:text-neutral-500">
                Entrenador | Valencia
              </p>
            </div>
          </div>
          <!-- End Card -->
      
          <!-- Card -->
          <div class="flex flex-col bg-white border border-gray-200 shadow-2xs rounded-xl dark:bg-neutral-900 dark:border-neutral-700">
            <div class="flex-auto p-4 md:p-6">
               
      
              <p class="mt-3 sm:mt-6 text-base text-gray-800 md:text-xl dark:text-white"><em>
                "Renové mi licencia de conducir en 20 minutos desde mi celular. ¡Increíble! "
              </em></p>
            </div>
      
            <div class="p-4 rounded-b-xl md:px-6">
              <h3 class="text-sm font-semibold text-gray-800 sm:text-base dark:text-neutral-200">
                Luisa
              </h3>
              <p class="text-sm text-gray-500 dark:text-neutral-500">
                Ama de Casa | Valencia
              </p>
            </div>
          </div>
          <!-- End Card -->
        </div>
        <!-- End Grid -->
      </div>
      <!-- End Testimonials --></section>
   
    <section
      class="my-10 grid grid-cols-1 md:grid-cols-2 justify-center items-center mx-auto"
    >
      <div class="py-8 px-4 md:px-12 flex flex-col justify-between">
        <h2 class="text-center">
          Trámites Legales en Línea: Sin Papeles ni Esperas
        </h2>
        <p>
          Gestionar documentos legales suele ser sinónimo de estrés. Por eso,
          hemos digitalizado los procesos más comunes:
        </p>
        <Lista
          titulolista="Constitución de Empresas: "
          listadescrip="Crea tu negocio en 48 horas con asesoría jurídica incluida."
        />
        <Lista
          titulolista="Renovación de Licencias: "
          listadescrip="Permisos comerciales, patentes municipales y más."
        />
        <Lista
          titulolista="Legalización de Documentos: "
          listadescrip="Apostillas, certificaciones notariales y trámites consulares."
        />
      </div>
      <div class="flex justify-center items-center">
        <img
          class="rounded-md my-3"
          src="/img/mujer-feliz.png"
          alt="registro corpoelec"
        />
      </div>
    </section>
  
  </Section>
  <Cta
  titulocta="¿Necesitas ayuda para pagar una factura o realizar un trámite?"
  descripcta="¡Estamos aquí para ayudarte! Contáctanos y te pondremos en contacto con un experto asesor."
  urlbotoncta="/contacto/"
  nomboton="Consulta a un Asesor"
  targetcta=""
/>
</Layout>
