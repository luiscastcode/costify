---
import {SEO} from '../AppConfig'
import NavHeader from "../components/NavHeader.astro";
import Footer from "../components/Footer.astro";
interface Props {
  metatitle: string;
  metadescrip: string;
  slug: string;
  structuredData:object;
}
const defaultProps = {
  
  structuredData: SEO.structuredData
};

const { metatitle, metadescrip, slug, structuredData = defaultProps.structuredData } = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    {structuredData && (
      <script is:inline
        type="application/ld+json"
        set:html={JSON.stringify(structuredData)}
      />
    )
    }
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/flowbite@2.5.2/dist/flowbite.min.css"
      rel="stylesheet"
    />
    <link href="/assets/app.css" rel="stylesheet" />
    <meta name="description" content={metadescrip} />
    <link rel="canonical" href={`https://pagarenlinea.site/${slug}`} />
    <title>{metatitle}</title>
    <!-- Twitter -->
    <meta property="twitter:title" content={metatitle} />
    <meta property="twitter:description" content={metadescrip} />
    <meta
      property="twitter:image"
      content="https://pagarenlinea.site/assets/img/social.webp"
    />
    <meta
      property="twitter:url"
      content={`https://pagarenlinea.site/${slug}`}
    />
    <meta property="twitter:card" content="summary_large_image" />

    <!-- Facebook -->
    <meta property="og:title" content={metatitle} />
    <meta property="og:description" content={metadescrip} />
    <meta property="og:url" content={`https://pagarenlinea.site/${slug}`} />
    <meta
      property="og:image"
      content="https://pagarenlinea.site/assets/img/social.webp"
    />
    <meta property="og:type" content="website" />
    <meta content="1200" property="og:image:width" />
    <meta content="600" property="og:image:height" />
    <meta content="image/png" property="og:image:type" />

    <meta name="robots" content="all" />
    <!-- Google tag (gtag.js) -->
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=G-JQVRF5Q6CR"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-JQVRF5Q6CR");
    </script>
    <style>
        /* Custom styles */
        
        .gradient-bg {
            background-image: linear-gradient(to top, #e3eeff 0%, #e3eeff 99%, #e3eeff 100%);
        }
        /* Spinner animation */
        .loader {
            border-top-color: #3498db;
            animation: spin 1s linear infinite;
        }
        @keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }
    </style>
  </head>
  <body class="gradient-bg">
    <NavHeader />
    <slot />
    <Footer />

    <script
      is:inline
      src="https://cdn.jsdelivr.net/npm/flowbite@2.5.2/dist/flowbite.min.js"
    ></script>
    
  </body>
</html>
